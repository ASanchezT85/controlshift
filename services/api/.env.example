DATABASE_URL="postgresql://controlshift:controlshift@127.0.0.1:5433/controlshift?schema=public"
JWT_SECRET="controlshift-dev-secret-change-me"
STORAGE_ROOT="../../storage"
ALLOW_UNSCANNED_ARTIFACTS="false"

# Malware scanning (MASTER SPEC 12). Unset means NO scanner: uploads stay
# RECEIVED and analysis refuses to consume them. That refusal is the default
# on purpose - a scanner that cannot answer has not cleared anything.
CLAMD_HOST=""
CLAMD_PORT="3310"
CLAMD_TIMEOUT_MS="30000"
