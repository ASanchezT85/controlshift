// ControlShift application persistence (MASTER SPEC 10/11/13/25/51/53).
//
// Every business entity is tenant-scoped (SPEC 51). Original artifacts and
// audit events are never mutated by application workflows (SPEC 11/53).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Report branding (MASTER SPEC 39). B2B2B: the integrator's name goes on the
  // cover, the end customer's name comes from the opportunity.
  brandName    String?
  brandLogo    String? // data: URI, size-capped and raster-only
  reportFooter String?
  /// Line under the preparer's name on every cover, e.g. a department or a
  /// professional registration. Optional (SPEC 39).
  preparedByLine String?

  // Organization estimating policy (SPEC 32/33). Owned by the organization,
  // never by ControlShift.
  uncertaintyAllowancePercent Float @default(15)

  users         User[]
  opportunities Opportunity[]
  auditEvents   AuditEvent[]
  effortTemplates EffortTemplate[]
}

/// An organization's own effort template (SPEC 32). ControlShift ships defaults
/// as a starting point and claims no universal engineering-hour values.
model EffortTemplate {
  id       String @id @default(uuid())
  tenantId String

  workPackageCode String
  unitType        String
  role            String

  minHoursPerUnit Float
  maxHoursPerUnit Float
  /// Multiplies both ends. 1.0 unless the organization says otherwise.
  complexityFactor Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workPackageCode, unitType])
  @@index([tenantId])
}

enum Role {
  ORG_ADMIN
  CONTROLS_ENGINEER
  ESTIMATOR
  PROJECT_MANAGER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum OpportunityStatus {
  DRAFT
  ANALYZING
  ANALYZED
  ENGINEERING_REVIEW
  COMMERCIAL_REVIEW
  CLOSED
}

enum ProposalType {
  ROM
  BUDGETARY
  FIXED_PRICE
  TIME_AND_MATERIAL
  DISCOVERY_ONLY
}

model Opportunity {
  id       String @id @default(uuid())
  tenantId String

  name         String
  customerName String
  facilityName String

  sourcePlatform  String       @default("SLC500")
  requestedTarget String       @default("CompactLogix 5380")
  proposalType    ProposalType
  proposalDeadline DateTime?

  shutdownRequirementHours Float?
  commercialNotes          String?

  /// The end customer's logo, for B2B2B delivery. Optional (SPEC 39).
  customerLogo String?

  // Human determinations that feed the SPEC 35 gate. False until a person
  // says otherwise - the engine never assumes them.
  engineeringReviewComplete Boolean @default(false)
  shutdownFeasible          Boolean @default(false)

  status    OpportunityStatus @default(DRAFT)
  createdBy String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]
  analyses    Analysis[]
  assumptions Assumption[]
  exclusions  Exclusion[]

  @@index([tenantId, status])
}

enum ArtifactType {
  PLC_SOURCE
  SYMBOL_DATABASE
  IO_LIST
  ELECTRICAL_DRAWING
  NETWORK_DRAWING
  HMI_PROJECT
  DRIVE_BACKUP
  PHOTO
  SPREADSHEET
  CUSTOMER_NOTE
  MIGRATION_REPORT
  OTHER
}

enum ProcessingStatus {
  RECEIVED
  SCANNED
  PARSED
  REJECTED
}

model Artifact {
  id            String @id @default(uuid())
  opportunityId String

  originalFilename String
  mediaType        String
  artifactType     ArtifactType

  sha256 String
  size   Int

  processingStatus ProcessingStatus @default(RECEIVED)
  rejectionReason  String?

  /// Content-addressed location under storage/original/. Immutable (SPEC 11).
  storageLocation String

  createdAt DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, sha256])
  @@index([opportunityId])
}

model Analysis {
  id            String @id @default(uuid())
  opportunityId String

  // Every assessment records exactly what produced it (SPEC 24/70).
  schemaVersion        String
  parserVersion        String
  irSchemaVersion      String
  analysisEngineVersion String
  rulePackVersion      String

  targetStrategy String

  // The human determinations this assessment was computed with. Recorded so a
  // verdict can be compared against the opportunity as it stands now, and so
  // the run stays reproducible (SPEC 70).
  engineeringReviewComplete Boolean @default(false)
  shutdownFeasible          Boolean @default(false)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  failed     Boolean   @default(false)
  failure    String?

  /// The engine's AnalysisResult verbatim. Re-analysis creates a NEW row; an
  /// earlier assessment is never erased (SPEC 24).
  result Json?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reviews     FindingReview[]
  reports     Report[]

  @@index([opportunityId, startedAt])
}

enum ReportKind {
  ENGINEERING_PREFLIGHT
  PROPOSAL_INPUT_PACKAGE
  CUSTOMER_INFORMATION_REQUEST
}

/// A generated deliverable (SPEC 38). Immutable once written: regenerating
/// produces a new row, so a document that was sent can always be reproduced.
model Report {
  id         String @id @default(uuid())
  analysisId String

  kind ReportKind

  storageLocation String
  sha256          String
  sizeBytes       Int

  reportSchemaVersion String

  generatedBy String
  createdAt   DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, kind])
}

enum ValidationState {
  ASSUMED
  VALIDATED
  INVALIDATED
}

/// A proposition temporarily accepted for estimating (MASTER SPEC 29).
/// Visible in commercial outputs, with the consequence of being wrong stated
/// next to it.
model Assumption {
  id            String @id @default(uuid())
  opportunityId String

  statement          String
  basis              String
  consequenceIfFalse String

  affectedScope String[]

  validationState ValidationState @default(ASSUMED)

  /// The unknown this assumption was proposed from, when it came from one.
  sourceUnknownId String?

  createdBy  String
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

/// Scope deliberately left out (MASTER SPEC 30). An exclusion is not an
/// exclusion until a commercial reviewer approves it: until then it is a
/// proposal, and reports say so.
model Exclusion {
  id            String @id @default(uuid())
  opportunityId String

  scopeArea String
  reason    String

  relatedUnknowns String[]
  relatedFindings String[]

  approvedBy String?
  approvedAt DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

enum ReviewAction {
  ACKNOWLEDGE
  ACCEPT
  REJECT
  RESOLVE
  OVERRIDE
}

/// Engineer decisions layered ON TOP of findings. The original finding lives
/// in Analysis.result and is never rewritten (SPEC 36).
model FindingReview {
  id         String @id @default(uuid())
  analysisId String
  findingId  String

  action      ReviewAction
  reason      String?
  overrideState String?

  reviewerId String
  createdAt  DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, findingId])
}

/// Append-only (SPEC 53). No update or delete path exists in the application.
model AuditEvent {
  id       String @id @default(uuid())
  tenantId String

  actorId    String?
  action     String
  subjectType String
  subjectId  String
  detail     Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
